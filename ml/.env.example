# Key callers must send in X-API-Key (must match the server's ML_API_KEY)
ML_API_KEY=leap-dev-ml-key

# Where the ML service pulls the catalogue and interaction matrix from
LEAP_API_URL=http://127.0.0.1:4000/api/v1
LEAP_API_KEY=leap-dev-ml-key

# Model artifact metadata directory
REGISTRY_DIR=registry

# Content vector encoder: auto (prefers sentence-transformer, falls back to tfidf), sentence-transformer, or tfidf
CONTENT_ENCODER=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2
