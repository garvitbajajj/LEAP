{
  "info": {
    "name": "LEAP API (Complete Collection)",
    "_postman_id": "8c5d91b4-3f6e-4f13-93ce-71e3f25a0001",
    "description": "Full Postman collection for LEAP (Learning Engine for Adaptive Personalization) covering all 5 authentication schemes, catalogue, bulk CSV import, recommendations, learning paths, events, analytics, and admin endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-login as learner if jwtToken is not yet set in the environment",
          "if (!pm.environment.get('jwtToken') && !pm.request.url.toString().includes('/auth/login')) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('apiBase') + '/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: {",
          "      mode: 'raw',",
          "      raw: JSON.stringify({",
          "        email: pm.environment.get('learnerEmail'),",
          "        password: pm.environment.get('learnerPassword')",
          "      })",
          "    }",
          "  }, function (err, res) {",
          "    if (!err && res.code === 200) {",
          "      var json = res.json();",
          "      if (json.token) pm.environment.set('jwtToken', json.token);",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Platform & OpenAPI",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Reports mongo and version', function () {",
                  "  var body = pm.response.json();",
                  "  pm.expect(body).to.have.property('mongo');",
                  "  pm.expect(body).to.have.property('version');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Prometheus Metrics",
          "request": { "method": "GET", "url": "{{baseUrl}}/metrics" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Exposes http_request_duration_seconds', function () {",
                  "  pm.expect(pm.response.text()).to.include('http_request_duration_seconds');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "OpenAPI JSON Spec",
          "request": { "method": "GET", "url": "{{apiBase}}/openapi.json" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Declares all 5 security schemes', function () {",
                  "  var schemes = Object.keys(pm.response.json().components.securitySchemes);",
                  "  pm.expect(schemes).to.include.members(['basicAuth', 'bearerAuth', 'jwtAuth', 'apiKeyAuth', 'oauth2']);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Auth (All 5 Schemes)",
      "item": [
        {
          "name": "Get Auth Providers",
          "request": { "method": "GET", "url": "{{apiBase}}/auth/providers" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Password login enabled', function () { pm.expect(pm.response.json().password).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Learner (jwtAuth)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{learnerEmail}}\",\n  \"password\": \"{{learnerPassword}}\"\n}" },
            "url": "{{apiBase}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Returns JWT and learner user', function () {",
                  "  pm.expect(data.token).to.be.a('string');",
                  "  pm.expect(data.user.role).to.eql('learner');",
                  "});",
                  "pm.environment.set('jwtToken', data.token);"
                ]
