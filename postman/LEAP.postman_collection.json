        {
          "name": "Refresh JWT (HttpOnly cookie)",
          "request": { "method": "POST", "url": "{{apiBase}}/auth/refresh" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200 with rotated JWT or 401 without cookie', function () {",
                  "  pm.expect([200, 401]).to.include(pm.response.code);",
                  "  if (pm.response.code === 200) { var r = pm.response.json(); pm.expect(r.token).to.be.a('string'); if (r.user && r.user.role === 'admin') { pm.environment.set('adminToken', r.token); } else if (r.user && r.user.role === 'learner') { pm.environment.set('jwtToken', r.token); } }",
