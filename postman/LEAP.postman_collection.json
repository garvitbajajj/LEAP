            }
          ]
        },
        {
          "name": "Login as Instructor (jwtAuth)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{instructorEmail}}\",\n  \"password\": \"{{instructorPassword}}\"\n}" },
            "url": "{{apiBase}}/auth/login"
