// LEAP — Multibranch Declarative Pipeline
// Author : Abhishek Vijay Kakde · V3 Recommendations & Feed
//
// Branch behaviour
// ─────────────────────────────────────────────────────────────────────────
//  Any branch   │ Checkout → Install → Lint → Test (parallel) → Build
//  feature/*    │ + SonarQube scan (non-blocking)
//  develop      │ + SonarQube scan (blocking gate) → Docker build
//  main         │ + Docker build → Push → Manual approval gate → Deploy
// ─────────────────────────────────────────────────────────────────────────
//
// Required Jenkins plugins:
//   Pipeline Multibranch        — multibranch project support
//   Git / GitHub Branch Source  — branch discovery & webhook trigger
//   NodeJS                      — tool "node20"
//   JUnit                       — test result publishing
//   HTML Publisher              — coverage report publishing
//   SonarQube Scanner           — optional static analysis
//   Docker Pipeline             — docker build/push steps
//
// Required Jenkins credentials:
//   dockerhub         — Username/Password for Docker Hub push
//   sonar-token       — Secret text with the SonarQube project token
//
// Required Jenkins tools:
//   NodeJS "node20"   — configure in Manage Jenkins > Tools

pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 45, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '5'))
    skipDefaultCheckout(false)
    // Throttle to prevent concurrent runs on the same branch overwriting each other's Docker tags
    disableConcurrentBuilds(abortPrevious: true)
  }

  tools {
    nodejs 'node20'
  }

  environment {
    REGISTRY     = 'docker.io/garvitbajajj'
    IMAGE_TAG    = "${env.BRANCH_NAME}-${env.BUILD_NUMBER}"
    SONAR_URL    = 'http://localhost:9000'
    // Which branches are allowed to push & deploy
    DEPLOY_BRANCHES = 'main'
    STAGING_BRANCHES = 'develop'
  }

  // ─── GitHub webhook trigger ──────────────────────────────────────────────
  // Requires the GitHub Branch Source plugin and a GitHub webhook pointing at:
  //   http://<JENKINS_URL>/multibranch-webhook-trigger/invoke?token=<TOKEN>
  // See docs/JENKINS_WEBHOOK_SETUP.md for the full setup procedure.
  triggers {
    githubPush()
  }

  stages {

    // ─── 1. Checkout ──────────────────────────────────────────────────────
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.GIT_COMMIT_SHORT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
          env.GIT_AUTHOR      = sh(script: "git log -1 --pretty='%an <%ae>'", returnStdout: true).trim()
          echo "Branch: ${env.BRANCH_NAME}  Commit: ${env.GIT_COMMIT_SHORT}  Author: ${env.GIT_AUTHOR}"
        }
      }
    }

    // ─── 2. Install dependencies (parallel) ──────────────────────────────
    stage('Install') {
      parallel {
        stage('server') {
          steps { dir('server') { sh 'npm ci --prefer-offline' } }
        }
        stage('client') {
          steps { dir('client') { sh 'npm ci --prefer-offline' } }
        }
        stage('ml') {
          steps {
            dir('ml') {
              sh '''
                python3 -m venv .venv
                .venv/bin/pip install --quiet --upgrade pip
                .venv/bin/pip install --quiet -r requirements.txt
              '''
            }
          }
        }
      }
    }

    // ─── 3. Lint ──────────────────────────────────────────────────────────
    stage('Lint') {
      steps {
        dir('server') { sh 'npm run lint' }
      }
    }

    // ─── 4. Test (parallel across all three services) ────────────────────
    stage('Unit Test') {
      parallel {
        stage('server - jest') {
          steps {
            dir('server') {
              sh 'npx jest --ci --coverage --coverageDirectory=coverage --coverageReporters=lcov,text'
            }
          }
          post {
            always {
              junit allowEmptyResults: true, testResults: 'server/jest-results.xml'
              publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: false,
                keepAll: true,
                reportDir: 'server/coverage/lcov-report',
                reportFiles: 'index.html',
                reportName: 'Server Coverage'
              ])
            }
          }
        }

        stage('ml - pytest') {
          steps {
            dir('ml') {
              sh '.venv/bin/python -m pytest -q --junitxml=pytest-results.xml --cov=app --cov-report=xml:coverage.xml --cov-report=html:htmlcov'
            }
          }
          post {
            always {
              junit allowEmptyResults: true, testResults: 'ml/pytest-results.xml'
              publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: false,
                keepAll: true,
                reportDir: 'ml/htmlcov',
                reportFiles: 'index.html',
                reportName: 'ML Coverage'
              ])
            }
          }
        }

        stage('client - vitest') {
          steps {
            dir('client') {
              sh 'npx vitest run --reporter=junit --outputFile=vitest-results.xml'
            }
          }
          post {
            always {
              junit allowEmptyResults: true, testResults: 'client/vitest-results.xml'
            }
          }
        }

        stage('e2e - maven unit') {
          steps {
            dir('tests/e2e') {
              sh 'mvn -B test'
            }
          }
          post {
            always {
              junit allowEmptyResults: true, testResults: 'tests/e2e/target/surefire-reports/*.xml'
            }
          }
        }
      }
    }

    // ─── 4b. Newman & Selenium E2E (when LEAP_E2E_URL is provided) ────────
    stage('Postman & Selenium E2E') {
      when { expression { env.LEAP_E2E_URL?.trim() } }
      steps {
        sh '''
          npx --yes newman run postman/LEAP.postman_collection.json \
            -e postman/LEAP.local.postman_environment.json \
            --env-var "baseUrl=${LEAP_E2E_URL}" \
            --env-var "apiBase=${LEAP_E2E_URL}/api/v1" \
            --insecure \
            --reporters cli,junit \
            --reporter-junit-export postman/newman-report.xml
        '''
        dir('tests/e2e') {
          sh 'mvn -B verify -Dleap.baseUrl=${LEAP_E2E_URL} -Dleap.headless=true'
        }
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'tests/e2e/target/failsafe-reports/*.xml,postman/newman-report.xml'
          archiveArtifacts allowEmptyArchive: true, artifacts: 'tests/e2e/target/screenshots/**'
        }
      }
    }

    // ─── 5. Build client bundle ───────────────────────────────────────────
    stage('Build') {
      steps {
        dir('client') { sh 'npm run build' }
      }
      post {
        success {
          archiveArtifacts artifacts: 'client/dist/**', allowEmptyArchive: true
        }
      }
    }

    // ─── 6. SonarQube static analysis ────────────────────────────────────
    // Runs on feature/* branches (warning only) and develop (quality gate blocks).
    stage('SonarQube Analysis') {
      when {
        anyOf {
          branch 'develop'
          branch pattern: 'feature/.*', comparator: 'REGEXP'
        }
      }
      steps {
        withSonarQubeEnv('SonarQube') {
          sh '''
            npx sonar-scanner \
              -Dsonar.projectKey=leap \
              -Dsonar.projectName="LEAP" \
              -Dsonar.sources=server/src,client/src,ml/app \
              -Dsonar.tests=server/tests,ml/tests \
              -Dsonar.javascript.lcov.reportPaths=server/coverage/lcov.info \
              -Dsonar.python.coverage.reportPaths=ml/coverage.xml \
              -Dsonar.host.url=${SONAR_URL}
          '''
        }
      }
    }

    // ─── 7. SonarQube Quality Gate (develop only — blocks the pipeline) ───
    stage('Quality Gate') {
      when { branch 'develop' }
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    // ─── 8. Docker images (develop and main only) ─────────────────────────
    stage('Docker Images') {
      when {
        anyOf {
          branch 'main'
          branch 'develop'
        }
      }
      steps {
        sh '''
          docker build -t $REGISTRY/leap-server:$IMAGE_TAG server
          docker build -t $REGISTRY/leap-ml:$IMAGE_TAG ml
          docker build -t $REGISTRY/leap-client:$IMAGE_TAG client
        '''
      }
    }

    // ─── 9. Push to registry (main only) ─────────────────────────────────
    stage('Push') {
      when { branch 'main' }
      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'dockerhub',
            usernameVariable: 'DH_USER',
            passwordVariable: 'DH_PASS'
          )
        ]) {
          sh '''
            echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
            for svc in server ml client; do
              docker push $REGISTRY/leap-$svc:$IMAGE_TAG
              docker tag  $REGISTRY/leap-$svc:$IMAGE_TAG $REGISTRY/leap-$svc:latest
              docker push $REGISTRY/leap-$svc:latest
            done
          '''
        }
      }
    }

    // ─── 10. Manual approval gate (main only) ────────────────────────────
    // A team lead must click "Proceed" in the Jenkins UI before the deploy runs.
    // The build parks here and waits; it auto-aborts after 24 hours if nobody acts.
    stage('Approval Gate') {
      when { branch 'main' }
      steps {
        script {
          def deployer = input(
            id: 'deploy-approval',
            message: "Deploy LEAP build #${env.BUILD_NUMBER} (${env.GIT_COMMIT_SHORT}) to production?",
            submitter: 'admin,devlead',
            submitterParameter: 'APPROVED_BY',
            ok: 'Proceed with Deploy',
            parameters: [
              choice(
                name: 'DEPLOY_ENV',
                choices: ['production', 'staging'],
                description: 'Target environment'
              ),
              booleanParam(
                name: 'RUN_SEED',
                defaultValue: false,
                description: 'Run the seed job after deploy? (WARNING: overwrites demo data)'
              )
            ]
          )
          env.DEPLOY_ENV  = deployer['DEPLOY_ENV']
          env.APPROVED_BY = deployer['APPROVED_BY']
          env.RUN_SEED    = deployer['RUN_SEED']
          echo "Deploy approved by ${env.APPROVED_BY} → target: ${env.DEPLOY_ENV}"
        }
      }
    }

    // ─── 11. Deploy (main only, after manual approval) ────────────────────
    stage('Deploy') {
      when { branch 'main' }
      steps {
        script {
          def composeCmd = "IMAGE_TAG=${env.IMAGE_TAG} docker compose up -d --build"
          if (env.DEPLOY_ENV == 'staging') {
            sh "COMPOSE_FILE=docker-compose.yml:docker-compose.staging.yml ${composeCmd}"
          } else {
            sh composeCmd
          }
          if (env.RUN_SEED == 'true') {
            sh "docker compose --profile seed run --rm seed"
          }
        }
      }
    }

  } // end stages

  // ─── Post-build actions ───────────────────────────────────────────────
  post {
    always {
      // Archive ML coverage XML for SonarQube / Codecov
      archiveArtifacts allowEmptyArchive: true,
        artifacts: 'ml/pytest-results.xml,ml/coverage.xml,server/coverage/**,client/vitest-results.xml'

      // Publish a build summary to the GitHub commit status
      script {
        def result  = currentBuild.currentResult ?: 'UNKNOWN'
        def emoji   = result == 'SUCCESS' ? '✅' : result == 'UNSTABLE' ? '⚠️' : '❌'
        def message = "${emoji} LEAP ${env.BRANCH_NAME}#${env.BUILD_NUMBER} — ${result}"
        echo message
      }
    }

    success {
      echo "✅ LEAP multibranch pipeline passed — branch: ${env.BRANCH_NAME}, commit: ${env.GIT_COMMIT_SHORT}"
    }

    unstable {
      echo "⚠️ LEAP pipeline is UNSTABLE — some tests failed; check the JUnit report."
    }

    failure {
      echo "❌ LEAP pipeline FAILED on branch: ${env.BRANCH_NAME} — check the stage logs above."
    }

    cleanup {
      // Remove dangling Docker build layers to keep the agent disk clean
      sh 'docker image prune -f || true'
      cleanWs()
    }
  }

}
