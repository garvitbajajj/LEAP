# --- server ---
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/leap
CORS_ORIGINS=http://localhost:5173

# --- JWT (jwtAuth) and refresh-token sessions ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TTL_DAYS=7
CLIENT_URL=http://localhost:5173

# --- opaque bearer token for internal status (bearerAuth) ---
INTERNAL_BEARER_TOKEN=leap-internal-dev-token

# --- HTTP Basic admin bootstrap (basicAuth) ---
BOOTSTRAP_ENABLED=true
BOOTSTRAP_USER=bootstrap
BOOTSTRAP_PASSWORD=bootstrap-dev-password

# --- ML service (apiKeyAuth, server -> ml) ---
ML_URL=http://127.0.0.1:8000
ML_API_KEY=leap-dev-ml-key
ML_TIMEOUT_MS=2000

# --- Google OAuth 2.0 (oauth2) ---
# Create an OAuth client (type "Web application") at https://console.cloud.google.com/apis/credentials
# and add GOOGLE_REDIRECT_URI below as an authorised redirect URI. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
